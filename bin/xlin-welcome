#!/usr/bin/env python3
"""Xlin-soft Welcome - the short first-run tour (theme, accent colour, Run Bar, shortcuts).

Starts by itself on the first login after installing; run `xlin welcome` to see it again.
"""
import os
import re
import subprocess
import sys
import threading

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
from gi.repository import Gdk, Gio, GLib, Gtk  # noqa: E402
import os as _os
sys.path[:0] = ["/usr/local/lib/xlin", _os.path.join(_os.path.dirname(_os.path.realpath(__file__)), "..", "lib")]
import xlin_ui  # noqa: E402

try:                       # thumbnails are a bonus: the page still works without them
    gi.require_version("GdkPixbuf", "2.0")
    from gi.repository import GdkPixbuf
except (ValueError, ImportError):
    GdkPixbuf = None

APP_ID = "dev.xlin.Welcome"
HOME = os.path.expanduser("~")
STATE = os.path.join(HOME, ".config/xlin/state")
CSS_FILE = os.path.join(HOME, ".config/xlin/tools.css")
ACCENTS = [("blue", "#5269dc"), ("teal", "#1f9d9a"), ("green", "#2f9e5f"),
           ("rose", "#c9507a"), ("orange", "#d9772b"), ("graphite", "#4a5568")]

FALLBACK_CSS = b"""
window.xlin-tools { border-radius: 11px; }
.welcome-title { font-size: 26px; font-weight: 700; }
.swatch { min-width: 30px; min-height: 30px; padding: 0; border-radius: 15px; }
.wall-thumb { padding: 3px; }
"""


def run(cmd, timeout=30):
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return p.returncode == 0, p.stdout
    except Exception:
        return False, ""


def run_msg(cmd, timeout=40):
    """Like run(), but returns (ok, the message to show the person)."""
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        text = (p.stderr.strip() or p.stdout.strip()).splitlines()
        return p.returncode == 0, (text[-1] if text else "")
    except Exception as e:
        return False, str(e)


def wallpaper_files():
    d = os.path.join(HOME, ".config/xlin/wallpapers")
    try:
        names = sorted(n for n in os.listdir(d) if n.lower().endswith((".jpg", ".jpeg", ".png", ".webp"))
                       and n not in ("xlin-light.png", "xlin-dark.png"))
    except OSError:
        return []
    return [os.path.join(d, n) for n in names]


def in_thread(fn, done=None):
    def work():
        r = fn()
        if done:
            GLib.idle_add(done, r)
    threading.Thread(target=work, daemon=True).start()


def read_state(name, default=""):
    try:
        with open(os.path.join(STATE, name)) as f:
            return f.read().strip() or default
    except OSError:
        return default


def write_state(name, value):
    try:
        os.makedirs(STATE, exist_ok=True)
        with open(os.path.join(STATE, name), "w") as f:
            f.write(value)
    except OSError:
        pass


def page(title, sub):
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
    box.set_vexpand(True)
    t = Gtk.Label(label=title, xalign=0, wrap=True)
    t.add_css_class("welcome-title")
    s = Gtk.Label(label=sub, xalign=0, wrap=True)
    s.add_css_class("welcome-sub")
    box.append(t)
    box.append(s)
    return box


_FONTS = {}


def font_families(mono):
    """Installed font family names (monospace only when mono), listed once."""
    if mono in _FONTS:
        return _FONTS[mono]
    ok, out = run(["fc-list", ":spacing=100" if mono else ":", "family"], 10)
    names = set()
    for line in (out or "").splitlines():
        first = line.split(",")[0].strip()
        if first and not first.startswith("."):
            names.add(first)
    _FONTS[mono] = sorted(names, key=str.lower)
    return _FONTS[mono]


def terminal_font():
    fam, size = "", "11.5"
    try:
        with open(os.path.expanduser("~/.config/kitty/xlin-font.conf")) as f:
            for ln in f:
                m = re.match(r'font_family\s+family="?([^"\n]+)"?', ln)
                if m:
                    fam = m.group(1)
                m = re.match(r"font_size\s+([0-9.]+)", ln)
                if m:
                    size = m.group(1)
    except OSError:
        pass
    return fam, size


def segmented(options, current, on_change):
    box = Gtk.Box(spacing=0)
    box.add_css_class("linked")
    first = None
    for value, label in options:
        b = Gtk.ToggleButton(label=label)
        if first is None:
            first = b
        else:
            b.set_group(first)
        if str(value) == str(current):
            b.set_active(True)
        b.connect("toggled", lambda btn, v=value: btn.get_active() and on_change(v))
        box.append(b)
    return box


def font_dropdown(families, current, on_pick):
    if current and current not in families:
        families = [current] + families
    dd = Gtk.DropDown.new_from_strings(families or [current or "DM Sans"])
    dd.set_enable_search(True)
    dd.set_expression(Gtk.PropertyExpression.new(Gtk.StringObject, None, "string"))
    dd.set_size_request(xlin_ui.scaled(200), -1)
    if current in families:
        dd.set_selected(families.index(current))
    state = {"ready": False}
    GLib.idle_add(lambda: (state.update(ready=True), False)[1])

    def changed(_d, _p):
        item = dd.get_selected_item()
        if state["ready"] and item is not None:
            on_pick(item.get_string())
    dd.connect("notify::selected", changed)
    return dd


def setting_row(title, sub, widget):
    r = Gtk.Box(spacing=12, margin_top=10)
    text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, hexpand=True, valign=Gtk.Align.CENTER)
    t = Gtk.Label(label=title, xalign=0)
    text.append(t)
    if sub:
        s = Gtk.Label(label=sub, xalign=0, wrap=True)
        s.add_css_class("welcome-sub")
        text.append(s)
    r.append(text)
    widget.set_valign(Gtk.Align.CENTER)
    r.append(widget)
    return r


def switch_row(title, sub, active, cb):
    sw = Gtk.Switch()
    sw.set_active(active)
    sw.connect("state-set", lambda _s, st: (cb(st), False)[1])
    return setting_row(title, sub, sw)


def slider_widget(value, cb, lo, hi):
    sc = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, lo, hi, 1)
    sc.set_value(value)
    sc.set_size_request(xlin_ui.scaled(220), -1)
    sc.set_draw_value(False)
    st = {"id": 0}

    def changed(_s):
        if st["id"]:
            GLib.source_remove(st["id"])
        st["id"] = GLib.timeout_add(150, lambda: (st.update(id=0), cb(sc.get_value()), False)[2])
    sc.connect("value-changed", changed)
    return sc


class WelcomeWindow(Gtk.ApplicationWindow):
    def __init__(self, app, reload_css):
        super().__init__(application=app, title="Welcome to Xlin-soft")
        self.reload_css = reload_css
        self.set_default_size(xlin_ui.scaled(720), xlin_ui.scaled(600))
        self.set_resizable(False)
        self.set_decorated(False)
        self.add_css_class("xlin-tools")

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        for m in ("top", "bottom", "start", "end"):
            getattr(root, f"set_margin_{m}")(26)
        self.set_child(root)

        handle = Gtk.WindowHandle()          # hold the top strip to move the window
        strip = Gtk.Box(spacing=8)
        name = Gtk.Label(label="Xlin-soft", xalign=0, hexpand=True)
        name.add_css_class("tool-title")
        strip.append(name)
        strip.append(xlin_ui.controls(self))
        handle.set_child(strip)
        root.append(handle)

        self.stack = Gtk.Stack()
        self.stack.set_vexpand(True)
        self.stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        root.append(self.stack)

        self.builders = [self.p_welcome, self.p_look, self.p_text, self.p_motion, self.p_wall, self.p_desktop,
                         self.p_comfort, self.p_keys, self.p_done]
        for i, b in enumerate(self.builders):
            sc = Gtk.ScrolledWindow(vexpand=True)
            sc.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
            inner = b()
            inner.set_margin_end(10)
            sc.set_child(inner)
            self.stack.add_named(sc, f"p{i}")
        self.index = 0

        bar = Gtk.Box(spacing=10)
        self.count = Gtk.Label(xalign=0, hexpand=True)
        self.count.add_css_class("welcome-sub")
        self.back = Gtk.Button(label="Back")
        self.back.add_css_class("welcome-ghost")
        self.back.connect("clicked", lambda _b: self.go(-1))
        self.next = Gtk.Button()
        self.next.add_css_class("welcome-primary")
        self.next.connect("clicked", lambda _b: self.go(1))
        self.settings_btn = Gtk.Button(label="Open Settings")
        self.settings_btn.add_css_class("welcome-ghost")
        self.settings_btn.set_tooltip_text("Change any of this later, and much more, in Settings")
        self.settings_btn.connect("clicked", lambda _b: xlin_ui.run(["xlin", "settings"]))
        self.manual_btn = Gtk.Button(label="Open Manual")
        self.manual_btn.add_css_class("welcome-ghost")
        self.manual_btn.set_tooltip_text("Read Xman, the Xlin-soft Manual")
        self.manual_btn.connect("clicked", lambda _b: xlin_ui.run(["xlin", "xman"]))
        for w in (self.count, self.manual_btn, self.settings_btn, self.back, self.next):
            bar.append(w)
        root.append(bar)
        self.go(0)

        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", self.on_key)
        self.add_controller(keys)
        self.connect("close-request", self.on_close)

    # ---- pages
    def p_welcome(self):
        b = page("Welcome to Xlin-soft", "A calm, clean desktop for Hyprland.\n\n"
                 "Take a minute to make it yours: pick light or dark, an accent colour, "
                 "and see the shortcuts. You can change everything later in Settings.")
        return b

    def p_look(self):
        b = page("Make it yours", "Choose how Xlin-soft looks.")
        modes = Gtk.Box(spacing=12, homogeneous=True)
        modes.set_margin_top(10)
        self.mode_buttons = {}
        cur = read_state("theme", "light")
        for key, label in (("light", "Light"), ("dark", "Dark")):
            btn = Gtk.Button(label=label)
            btn.add_css_class("welcome-choice")
            if key == cur:
                btn.add_css_class("active")
            btn.connect("clicked", lambda _b, k=key: self.set_mode(k))
            self.mode_buttons[key] = btn
            modes.append(btn)
        b.append(modes)

        lab = Gtk.Label(label="Accent colour", xalign=0, margin_top=14)
        lab.add_css_class("welcome-sub")
        b.append(lab)
        dots = Gtk.Box(spacing=10)
        self.dot_buttons = {}
        current = read_state("accent", "blue")
        for name, _hx in ACCENTS:
            d = Gtk.Button()
            d.add_css_class("swatch")
            d.add_css_class(f"swatch-{name}")
            d.set_tooltip_text(name.capitalize())
            if name == current:
                d.add_css_class("active")
            d.connect("clicked", lambda _b, n=name: self.set_accent(n))
            self.dot_buttons[name] = d
            dots.append(d)
        b.append(dots)
        return b

    def p_wall(self):
        b = page("Pick a wallpaper", "Click one to set it now. You can change it any time with Super+W.")
        self.wall_buttons = {}
        grid = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, max_children_per_line=4, min_children_per_line=4,
                           column_spacing=6, row_spacing=6, homogeneous=True)
        grid.set_margin_top(6)
        current = read_state("wallpaper", "")
        files = wallpaper_files()
        for path in files:
            btn = Gtk.Button()
            btn.add_css_class("wall-thumb")
            btn.set_tooltip_text(os.path.basename(path)[5:].rsplit(".", 1)[0].capitalize())
            pic = Gtk.Picture(can_shrink=True)
            pic.set_size_request(112, 64)
            pic.set_content_fit(Gtk.ContentFit.COVER)
            btn.set_child(pic)
            if path == current:
                btn.add_css_class("active")
            btn.connect("clicked", lambda _b, p=path: self.set_wall(p))
            self.wall_buttons[path] = btn
            grid.append(btn)
            self.load_thumb(pic, path)
        if files:
            b.append(grid)
        else:
            none = Gtk.Label(label="The built-in wallpapers are missing. Run ./update.sh in the Xlin-soft folder.", xalign=0, wrap=True)
            none.add_css_class("welcome-bad")
            b.append(none)
        own = Gtk.Button(label="Choose your own picture…", halign=Gtk.Align.START, margin_top=10)
        own.add_css_class("welcome-choice")
        own.connect("clicked", lambda _b: self.pick_own())
        b.append(own)
        self.wall_status = Gtk.Label(label="", xalign=0, wrap=True)
        self.wall_status.add_css_class("welcome-ok")
        b.append(self.wall_status)
        return b

    def p_text(self):
        b = page("Fonts and sizes", "Pick the fonts and how big the text is. Everything follows at once.")
        b.append(setting_row("System font", "Bars, panels and apps", font_dropdown(
            font_families(False), read_state("ui_font", "DM Sans"),
            lambda n: in_thread(lambda: run(["xlin", "font", n], 40)))))
        b.append(setting_row("Text size", "Bars, panels and apps", segmented(
            [("small", "Small"), ("normal", "Normal"), ("large", "Large"), ("huge", "Huge")],
            read_state("ui_size", "normal"), lambda v: in_thread(lambda: run(["xlin", "font", "size", v], 40)))))
        tfont, tsize = terminal_font()
        b.append(setting_row("Terminal font", "Monospace fonts only", font_dropdown(
            font_families(True), tfont, lambda n: in_thread(lambda: run(["xlin", "terminal", "font", n, tsize], 20)))))
        b.append(setting_row("Terminal text size", "Applies to new terminal windows", segmented(
            [("10", "Small"), ("11.5", "Normal"), ("13", "Large"), ("15", "Huge")], tsize,
            lambda v: in_thread(lambda: run(["xlin", "terminal", "font", tfont, v], 20)))))
        b.append(setting_row("Mouse cursor size", None, segmented(
            [("24", "Small"), ("32", "Medium"), ("48", "Large"), ("64", "Huge")], read_state("cursor_size", "24"),
            lambda v: in_thread(lambda: run(["xlin", "cursor", v])))))
        return b

    def p_motion(self):
        b = page("Motion and windows", "How lively the desktop feels.")
        b.append(setting_row("Animations", "Windows, Launcher, panels and workspaces", segmented(
            [("off", "Off"), ("subtle", "Subtle"), ("smooth", "Smooth")], read_state("animations", "smooth"),
            lambda v: in_thread(lambda: run(["xlin", "animations", v], 15)))))

        def set_opacity(v):
            val = "1.0" if v >= 100 else f"{v / 100:.2f}"
            in_thread(lambda: run(["xlin", "opacity", val]))
        b.append(setting_row("Window transparency", "Left: see-through, right: solid. Fullscreen windows are always solid",
                             slider_widget(85, set_opacity, 40, 100)))
        b.append(switch_row("Natural scrolling", "On: the page follows your fingers, like a phone. Off: the usual mouse wheel",
                            read_state("scroll", "normal") == "natural",
                            lambda on: in_thread(lambda: run(["xlin", "scroll", "natural" if on else "normal"], 10))))
        return b

    def p_desktop(self):
        b = page("Status bar and Run Bar", "Decide what you see around the desktop.")
        b.append(switch_row("Show the status bar", "Super+C still opens the control panel when it is off",
                            not os.path.exists(os.path.join(STATE, "statusbar_off")),
                            lambda on: in_thread(lambda: run(["xlin", "statusbar", "on" if on else "off"], 10))))
        hidden = set(read_state("bar_hidden", "").split())
        b.append(switch_row("Time and date on the status bar", None, "clock" not in hidden,
                            lambda on: in_thread(lambda: run(["xlin", "bar", "show" if on else "hide", "clock"]))))
        b.append(switch_row("Auto-hide the Run Bar", "Show it only when you reach the bottom edge",
                            read_state("dock_autohide", "on") != "off",
                            lambda on: in_thread(lambda: run(["xlin", "runbar", "autohide", "on" if on else "off"]))))
        b.append(setting_row("Run Bar icon size", None, segmented(
            [("32", "Small"), ("40", "Medium"), ("48", "Large")], read_state("dock_icon", "40"),
            lambda v: in_thread(lambda: run(["xlin", "runbar", "size", v])))))
        b.append(switch_row("Desktop layer", "Right-click menu, icons and widgets on the desktop",
                            not os.path.exists(os.path.join(STATE, "desktop_off")),
                            lambda on: in_thread(lambda: run(["xlin", "desktop", "on" if on else "off"], 20))))
        return b

    def p_comfort(self):
        b = page("Comfort and power", "Screen, sleep and lock.")
        b.append(switch_row("Lock when idle", "Lock the screen and sleep when you are away",
                            not os.path.exists(os.path.join(STATE, "idle_off")), self.set_idle))
        b.append(setting_row("Lock after", None, segmented(
            [("2", "2 min"), ("5", "5 min"), ("10", "10 min"), ("30", "30 min")], read_state("idle_minutes", "5"),
            lambda v: in_thread(lambda: run(["xlin", "idle", "set", v], 20)))))
        b.append(setting_row("Sleep after", "The screen locks just before", segmented(
            [("5", "5 min"), ("10", "10 min"), ("15", "15 min"), ("30", "30 min"), ("off", "Never")],
            read_state("sleep_minutes", "5"), lambda v: in_thread(lambda: run(["xlin", "idle", "sleep", v], 20)))))
        b.append(switch_row("Night light", "A warmer screen colour in the evening",
                            read_state("nightlight", "") != "",
                            lambda on: in_thread(lambda: run(["xlin", "nightlight", "on" if on else "off"], 20))))
        b.append(switch_row("Keep apps ready", "Settings, Files and the Store wait out of sight so they open instantly",
                            not os.path.exists(os.path.join(STATE, "warm_off")),
                            lambda on: in_thread(lambda: run(["xlin", "warm", "on" if on else "off"], 20))))
        return b

    def p_done(self):
        b = page("You're all set", "A few things worth knowing:")
        for key, text in (("Super + Space", "Open the launcher and find any app"),
                          ("Super + /", "Show every shortcut"),
                          ("Super + S", "Open Settings (updates are in About)"),
                          ("Super + T", "Tools: notes, calculator and calendar")):
            r = Gtk.Box(spacing=14, margin_top=8)
            k = Gtk.Label(label=key, xalign=0)
            k.set_size_request(xlin_ui.scaled(120), -1)
            k.add_css_class("welcome-keys")
            r.append(k)
            r.append(Gtk.Label(label=text, xalign=0))
            b.append(r)
        more = Gtk.Button(label="Open Settings to change anything", halign=Gtk.Align.START, margin_top=16)
        more.add_css_class("welcome-choice")
        more.connect("clicked", lambda _b: xlin_ui.run(["xlin", "settings"]))
        b.append(more)
        tip = Gtk.Label(label="Something wrong later? Open SysDeb and press Fix everything. "
                              "The X button on the status bar opens Xman, the Xlin-soft Manual.", xalign=0, wrap=True, margin_top=10)
        tip.add_css_class("welcome-sub")
        b.append(tip)
        return b

    def p_keys(self):
        b = page("Shortcuts", "Press Super+/ any time to see this list again.")
        ok, out = run(["xlin", "keys"], 5)
        text = re.sub(r"\x1b\[[0-9;]*m", "", out) if ok and out else "Run `xlin keys` in a terminal."
        lab = Gtk.Label(label=text.strip(), xalign=0, yalign=0, selectable=False)
        lab.add_css_class("welcome-keys")
        sc = Gtk.ScrolledWindow()
        sc.set_vexpand(True)
        sc.set_child(lab)
        sc.set_margin_top(6)
        b.append(sc)
        return b

    # ---- actions
    def load_thumb(self, pic, path):
        if GdkPixbuf is None:
            return

        def work():
            try:
                pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, 224, 128, True)
            except Exception:
                return
            GLib.idle_add(lambda: (pic.set_paintable(Gdk.Texture.new_for_pixbuf(pb)), False)[1])
        threading.Thread(target=work, daemon=True).start()

    def set_wall(self, path):
        for p, btn in self.wall_buttons.items():
            (btn.add_css_class if p == path else btn.remove_css_class)("active")
        self.wall_status.set_text("Setting the wallpaper…")
        self.wall_status.remove_css_class("welcome-bad")
        in_thread(lambda: run_msg(["xlin", "wallpaper", path]), self.wall_done)

    def wall_done(self, res):
        ok, msg = res
        self.wall_status.set_text("Wallpaper changed." if ok else (msg or "Could not change the wallpaper."))
        (self.wall_status.remove_css_class if ok else self.wall_status.add_css_class)("welcome-bad")
        return False

    def pick_own(self):
        dlg = Gtk.FileDialog(title="Choose a wallpaper")
        flt = Gtk.FileFilter()
        flt.set_name("Pictures")
        for pat in ("*.png", "*.jpg", "*.jpeg", "*.webp"):
            flt.add_pattern(pat)
        store = Gio.ListStore.new(Gtk.FileFilter)
        store.append(flt)
        dlg.set_filters(store)

        def done(d, res):
            try:
                f = d.open_finish(res)
            except GLib.Error:
                return
            if f and f.get_path():
                self.set_wall(f.get_path())
        dlg.open(self, None, done)

    def set_mode(self, key):
        for k, btn in self.mode_buttons.items():
            (btn.add_css_class if k == key else btn.remove_css_class)("active")
        in_thread(lambda: run(["xlin", "theme", key]), lambda _r: self.reload_css())

    def set_accent(self, name):
        for k, btn in self.dot_buttons.items():
            (btn.add_css_class if k == name else btn.remove_css_class)("active")
        in_thread(lambda: run(["xlin", "accent", name]), lambda _r: self.reload_css())

    def set_autohide(self, on):
        in_thread(lambda: run(["xlin", "runbar", "autohide", "on" if on else "off"]))

    def set_idle(self, on):
        in_thread(lambda: run(["xlin", "idle", "on" if on else "off"]))

    # ---- navigation
    def go(self, step):
        self.index = max(0, min(len(self.builders) - 1, self.index + step))
        if step > 0 and self.index == len(self.builders) - 1 and self.next.get_label() == "Start using Xlin-soft":
            self.close()
            return
        self.stack.set_visible_child_name(f"p{self.index}")
        last = self.index == len(self.builders) - 1
        self.next.set_label("Start using Xlin-soft" if last else "Next")
        self.back.set_visible(self.index > 0)
        self.count.set_text(f"{self.index + 1} of {len(self.builders)}")

    def on_key(self, _c, keyval, _code, _state):
        if keyval == Gdk.KEY_Escape:
            self.close()
            return True
        return False

    def on_close(self, *_a):
        write_state("welcomed", "1")     # closing = done, it will not show again by itself
        return False


class WelcomeApp(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.FLAGS_NONE)
        self.win = None
        self.theme_provider = None

    def css(self):
        out = FALLBACK_CSS + b"\n" + "".join(
            f".swatch-{n} {{ background-color: {hx}; }}\n" for n, hx in ACCENTS).encode()
        return out

    def theme_css(self):
        try:
            with open(CSS_FILE, "rb") as f:
                return f.read()
        except OSError:
            return b""

    def reload_css(self):
        if self.theme_provider is not None:
            try:
                self.theme_provider.load_from_data(self.theme_css())
            except Exception:
                pass
        return False

    def do_startup(self):
        Gtk.Application.do_startup(self)
        xlin_ui.live_css()      # restyle at once when the theme or font changes (warm apps too)
        display = Gdk.Display.get_default()
        base = Gtk.CssProvider()
        base.load_from_data(self.css())
        Gtk.StyleContext.add_provider_for_display(display, base, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        self.theme_provider = Gtk.CssProvider()
        self.reload_css()
        Gtk.StyleContext.add_provider_for_display(display, self.theme_provider,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1)

    def do_activate(self):
        if self.win is None:
            self.win = WelcomeWindow(self, self.reload_css)
        self.win.present()


if __name__ == "__main__":
    sys.exit(WelcomeApp().run([sys.argv[0]]))
