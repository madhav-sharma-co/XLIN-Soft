# ------------------------------------------------------------ screenshot
class ClockView(Gtk.Box):
    """Clock (with a few time zones), stopwatch and timer."""
    ZONES = [("Kolkata", "Asia/Kolkata"), ("London", "Europe/London"), ("New York", "America/New_York"),
             ("Dubai", "Asia/Dubai"), ("Tokyo", "Asia/Tokyo"), ("Sydney", "Australia/Sydney")]

    def __init__(self):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        self.window = None
        self.sw = {"running": False, "start": 0.0, "base": 0.0, "laps": []}
        self.tm = {"total": 300.0, "left": 300.0, "running": False, "end": 0.0}

        tabs = Gtk.Box(spacing=0)
        tabs.add_css_class("linked")
        self.stack = Gtk.Stack()
        self.stack.set_vexpand(True)
        first = None
        pages = (("clock", "Clock", self.clock_page()), ("stopwatch", "Stopwatch", self.stopwatch_page()),
                 ("timer", "Timer", self.timer_page()))
        for key, label, page in pages:
            self.stack.add_named(page, key)
            b = Gtk.ToggleButton(label=label, hexpand=True)
            if first is None:
                first = b
                b.set_active(True)
            else:
                b.set_group(first)
            b.connect("toggled", lambda btn, k=key: btn.get_active() and self.stack.set_visible_child_name(k))
            tabs.append(b)
        self.append(tabs)
        self.append(self.stack)
        GLib.timeout_add(100, self.tick)
        self.tick()

    # ---- pages
    def clock_page(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        self.big = Gtk.Label(label="", xalign=0)
        self.big.add_css_class("clock-big")
        self.date = Gtk.Label(label="", xalign=0)
        self.date.add_css_class("clock-sub")
        box.append(self.big)
        box.append(self.date)
        self.zones = []
        try:
            from zoneinfo import ZoneInfo
            for city, tz in self.ZONES:
                row = Gtk.Box(spacing=8, margin_top=6)
                name = Gtk.Label(label=city, xalign=0, hexpand=True)
                t = Gtk.Label(label="", xalign=1)
                t.add_css_class("clock-city")
                row.append(name)
                row.append(t)
                box.append(row)
                self.zones.append((ZoneInfo(tz), t))
        except Exception:
            self.zones = []
        return box

    def stopwatch_page(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.sw_label = Gtk.Label(label="00:00.00", xalign=0)
        self.sw_label.add_css_class("clock-big")
        box.append(self.sw_label)
        row = Gtk.Box(spacing=6, homogeneous=True)
        self.sw_start = Gtk.Button(label="Start")
        self.sw_start.connect("clicked", lambda _b: self.sw_toggle())
        lap = Gtk.Button(label="Lap")
        lap.connect("clicked", lambda _b: self.sw_lap())
        reset = Gtk.Button(label="Reset")
        reset.connect("clicked", lambda _b: self.sw_reset())
        for b in (self.sw_start, lap, reset):
            row.append(b)
        box.append(row)
        self.laps = Gtk.Label(label="", xalign=0, yalign=0, vexpand=True)
        self.laps.add_css_class("clock-sub")
        box.append(self.laps)
        return box

    def timer_page(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.tm_label = Gtk.Label(label="05:00", xalign=0)
        self.tm_label.add_css_class("clock-big")
        box.append(self.tm_label)
        presets = Gtk.Box(spacing=6, homogeneous=True)
        for mins in (1, 5, 10, 25):
            b = Gtk.Button(label=f"{mins} min")
            b.connect("clicked", lambda _b, m=mins: self.tm_set(m * 60))
            presets.append(b)
        box.append(presets)
        custom = Gtk.Box(spacing=6)
        self.tm_entry = Gtk.Entry(hexpand=True)
        self.tm_entry.set_placeholder_text("Minutes, e.g. 12 or 0.5")
        self.tm_entry.connect("activate", lambda _e: self.tm_custom())
        custom.append(self.tm_entry)
        setb = Gtk.Button(label="Set")
        setb.connect("clicked", lambda _b: self.tm_custom())
        custom.append(setb)
        box.append(custom)
        row = Gtk.Box(spacing=6, homogeneous=True)
        self.tm_start = Gtk.Button(label="Start")
        self.tm_start.connect("clicked", lambda _b: self.tm_toggle())
        reset = Gtk.Button(label="Reset")
        reset.connect("clicked", lambda _b: self.tm_set(self.tm["total"]))
        row.append(self.tm_start)
        row.append(reset)
        box.append(row)
        box.append(Gtk.Box(vexpand=True))
        return box

    # ---- stopwatch
    def sw_now(self):
        s = self.sw
        return s["base"] + (time.monotonic() - s["start"] if s["running"] else 0.0)

    @staticmethod
    def fmt(sec, cs=False):
        m, s = divmod(sec, 60)
        h, m = divmod(int(m), 60)
        base = f"{m:02d}:{int(s):02d}" + (f".{int((s % 1) * 100):02d}" if cs else "")
        return f"{h}:{base}" if h else base

    def sw_toggle(self):
        s = self.sw
        if s["running"]:
            s["base"] = self.sw_now()
            s["running"] = False
        else:
            s["start"] = time.monotonic()
            s["running"] = True
        self.sw_start.set_label("Stop" if s["running"] else "Start")

    def sw_lap(self):
        if self.sw["running"]:
            self.sw["laps"].append(self.sw_now())
            laps = self.sw["laps"][-6:]
            n0 = len(self.sw["laps"]) - len(laps)
            self.laps.set_text("\n".join(f"Lap {n0 + i + 1}   {self.fmt(t, True)}" for i, t in enumerate(laps)))

    def sw_reset(self):
        self.sw.update(running=False, base=0.0, laps=[])
        self.sw_start.set_label("Start")
        self.laps.set_text("")

    # ---- timer
    def tm_left(self):
        t = self.tm
        return max(0.0, t["end"] - time.monotonic()) if t["running"] else t["left"]

    def tm_set(self, seconds):
        self.tm.update(total=float(seconds), left=float(seconds), running=False)
        self.tm_start.set_label("Start")

    def tm_custom(self):
        try:
            mins = float(self.tm_entry.get_text().replace(",", ".").strip())
        except ValueError:
            return
        if 0 < mins <= 600:
            self.tm_set(mins * 60)

    def tm_toggle(self):
        t = self.tm
        if t["running"]:
            t["left"] = self.tm_left()
            t["running"] = False
        else:
            if t["left"] <= 0:
                t["left"] = t["total"]
            t["end"] = time.monotonic() + t["left"]
            t["running"] = True
        self.tm_start.set_label("Pause" if t["running"] else "Start")

    # ---- one timer for everything on screen
    def tick(self):
        now = datetime.now()
        self.big.set_text(now.strftime("%H:%M:%S"))
        self.date.set_text(now.strftime("%A, %d %B %Y"))
        for zone, label in self.zones:
            z = datetime.now(zone)
            label.set_text(z.strftime("%H:%M   ") + z.strftime("%a"))
        self.sw_label.set_text(self.fmt(self.sw_now(), True))
        left = self.tm_left()
        self.tm_label.set_text(self.fmt(left + (0.99 if self.tm["running"] else 0)))
        if self.tm["running"] and left <= 0:
            self.tm.update(running=False, left=0.0)
            self.tm_start.set_label("Start")
            try:
                subprocess.Popen(["notify-send", "-a", "Xlin-soft", "-u", "critical", "Timer finished", "Time is up"],
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except OSError:
                pass
        return True

    def on_key(self, _keyval):
        return False


class ScreenshotView(Gtk.Box):
    """Pick what to capture; the window closes first so it is not in the picture."""

    def __init__(self):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        self.window = None
        self.delay = 0
        for mode, label, sub, icon in (
                ("region", "Select an area", "Drag a rectangle", "view-fullscreen-symbolic"),
                ("window", "A window", "Click the window you want", "window-new-symbolic"),
                ("full", "The whole screen", "Everything you see", "video-display-symbolic")):
            row = Gtk.Button()
            row.add_css_class("tools-item")
            box = Gtk.Box(spacing=12)
            img = Gtk.Image.new_from_icon_name(icon)
            img.set_pixel_size(22)
            box.append(img)
            text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
            a = Gtk.Label(label=label, xalign=0)
            b = Gtk.Label(label=sub, xalign=0)
            b.add_css_class("tools-sub")
            text.append(a)
            text.append(b)
            box.append(text)
            row.set_child(box)
            row.connect("clicked", lambda _b, m=mode: self.capture(m))
            self.append(row)

        d = Gtk.Box(spacing=0, margin_top=8)
        d.add_css_class("linked")
        lab = Gtk.Label(label="Delay", xalign=0, hexpand=True)
        lab.add_css_class("tools-sub")
        top = Gtk.Box(spacing=8, margin_top=6)
        top.append(lab)
        first = None
        for secs, text in ((0, "None"), (3, "3 s"), (5, "5 s"), (10, "10 s")):
            t = Gtk.ToggleButton(label=text)
            t.add_css_class("seg-btn")
            if first is None:
                first = t
                t.set_active(True)
            else:
                t.set_group(first)
            t.connect("toggled", lambda b, s=secs: b.get_active() and setattr(self, "delay", s))
            d.append(t)
        top.append(d)
        self.append(top)

        self.opts = {"--copy": False, "--pointer": False, "--open": False}
        for flag, text in (("--pointer", "Include the mouse pointer"), ("--copy", "Copy only (do not save a file)"),
                           ("--open", "Open it afterwards")):
            r = Gtk.Box(spacing=8, margin_top=2)
            l = Gtk.Label(label=text, xalign=0, hexpand=True)
            l.add_css_class("tools-sub")
            sw = Gtk.Switch(valign=Gtk.Align.CENTER)
            sw.connect("state-set", lambda _s, st, f=flag: (self.opts.__setitem__(f, st), False)[1])
            r.append(l)
            r.append(sw)
            self.append(r)

        folder = Gtk.Button(label="Open the Screenshots folder", margin_top=4)
        folder.add_css_class("welcome-ghost")
        folder.connect("clicked", lambda _b: self.open_folder())
        self.append(folder)

    def capture(self, mode):
        wait = self.delay + 0.5           # 0.5 s so this window is gone before the picture is taken
        flags = " ".join(f for f, on in self.opts.items() if on)
        note = (f"notify-send -t {int(self.delay * 1000)} -a Xlin-soft 'Screenshot' 'Taking it in {self.delay} s' >/dev/null 2>&1; "
                if self.delay else "")
        subprocess.Popen(["sh", "-c", f"{note}sleep {wait}; exec xlin screenshot {mode} {flags}"], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if self.window is not None:
            self.window.close()

    def open_folder(self):
        folder = os.path.expanduser("~/Pictures/Screenshots")
        os.makedirs(folder, exist_ok=True)
        subprocess.Popen(["xlin", "files", folder], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if self.window is not None:
            self.window.close()

    def on_key(self, keyval):
        return False


class ToolWindow(Gtk.ApplicationWindow):
    """Base: borderless window with a drag strip. Subclasses fill self.body."""

    def __init__(self, app, title, width, height, with_close, resizable=False):
        super().__init__(application=app, title=title)
        self.set_default_size(xlin_ui.scaled(width), xlin_ui.scaled(height))
        self.set_resizable(resizable)
        self.set_decorated(False)
        self.add_css_class("xlin-tools")

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        for m in ("top", "bottom", "start", "end"):
            getattr(root, f"set_margin_{m}")(14)
        self.set_child(root)

        # The drag strip: hold it and move the window anywhere on the screen
        handle = Gtk.WindowHandle()
        strip = Gtk.Box(spacing=8)
        t = Gtk.Label(label=title, xalign=0, hexpand=True)
        t.add_css_class("tool-title")
        strip.append(t)
        if with_close:
            strip.append(xlin_ui.controls(self))
        handle.set_child(strip)
        root.append(handle)

        self.body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, vexpand=True)
        root.append(self.body)


class MenuWindow(ToolWindow):
    """The small dropdown: one row per tool."""

    def __init__(self, app):
        super().__init__(app, "Tools", MENU_W, MENU_H, with_close=False)
        self.was_active = False
        for key, (label, _id, _w, _h, sub, icon) in TOOLS.items():
            row = Gtk.Button()
            row.add_css_class("tools-item")
            box = Gtk.Box(spacing=12)
            img = Gtk.Image.new_from_icon_name(icon)
            img.set_pixel_size(22)
            box.append(img)
            text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
            a = Gtk.Label(label=label, xalign=0)
            b = Gtk.Label(label=sub, xalign=0)
            b.add_css_class("tools-sub")
            text.append(a)
            text.append(b)
            box.append(text)
            row.set_child(box)
            row.connect("clicked", lambda _b, k=key: self.open_tool(k))
            self.body.append(row)

        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", self.on_key_pressed)
        self.add_controller(keys)
        self.connect("notify::is-active", self.on_active)

    def open_tool(self, key):
        exe = shutil.which("xlin-tools") or os.path.abspath(__file__)
        subprocess.Popen([exe, key], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        GLib.timeout_add(80, self.close_now)

    def close_now(self):
        self.close()
        return False

    def on_key_pressed(self, _c, keyval, _code, _state):
        if keyval == Gdk.KEY_Escape:
            self.close()
            return True
        return False

    # close like a dropdown when you click somewhere else
    def on_active(self, *_a):
        if self.is_active():
            self.was_active = True
        elif self.was_active:
            GLib.timeout_add(150, self.close_if_inactive)

    def close_if_inactive(self):
        if not self.is_active():
            self.close()
        return False


class PowerWindow(ToolWindow):
    """Battery dropdown: charge level plus the power mode (saver / balanced / performance)."""

    def __init__(self, app):
        super().__init__(app, "Battery", POWER_W, POWER_H, with_close=False)
        self.was_active = False
        self.rows = {}

        self.big = Gtk.Label(xalign=0)
        self.big.add_css_class("power-big")
        self.sub = Gtk.Label(xalign=0)
        self.sub.add_css_class("tools-sub")
        self.bar = Gtk.LevelBar(min_value=0, max_value=100)
        self.bar.add_css_class("power-bar")
        for w in (self.big, self.sub, self.bar):
            self.body.append(w)

        sep = Gtk.Label(label="Power mode", xalign=0, margin_top=10)
        sep.add_css_class("tools-sub")
        self.body.append(sep)

        avail = profile_available()
        if not avail:
            msg = Gtk.Label(wrap=True, xalign=0, margin_top=4,
                            label="Power modes need power-profiles-daemon:\n"
                                  "sudo pacman -S power-profiles-daemon\n"
                                  "sudo systemctl enable --now power-profiles-daemon")
            msg.add_css_class("tools-sub")
            msg.set_selectable(True)
            self.body.append(msg)
        for key, label, sub in MODES:
            if avail and key not in avail:
                continue
            row = Gtk.Button()
            row.add_css_class("tools-item")
            box = Gtk.Box(spacing=10)
            text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1, hexpand=True)
            a = Gtk.Label(label=label, xalign=0)
            b = Gtk.Label(label=sub, xalign=0)
            b.add_css_class("tools-sub")
            text.append(a)
            text.append(b)
            tick = Gtk.Label(label="")
            box.append(text)
            box.append(tick)
            row.set_child(box)
            row.set_sensitive(bool(avail))
            row.connect("clicked", lambda _b, k=key: self.pick(k))
            self.rows[key] = (row, tick)
            self.body.append(row)

        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", self.on_key_pressed)
        self.add_controller(keys)
        self.connect("notify::is-active", self.on_active)
        self.refresh()
        GLib.timeout_add_seconds(5, self.refresh)

    def refresh(self):
        info = read_battery()
        if info is None:
            self.big.set_text("No battery")
            self.sub.set_text("This computer runs on mains power")
            self.bar.set_value(0)
        else:
            pct, status, mins = info
            self.big.set_text(f"{pct}%")
            self.bar.set_value(pct)
            word = {"Charging": "Charging", "Full": "Fully charged",
                    "Discharging": "On battery", "Not charging": "Plugged in"}.get(status, status)
            if mins is not None and status in ("Charging", "Discharging"):
                h, m = divmod(mins, 60)
                word += f" · {h}h {m:02d}m " + ("until full" if status == "Charging" else "left")
            self.sub.set_text(word)
        cur = profile_get()
        for key, (row, tick) in self.rows.items():
            tick.set_text("✓" if key == cur else "")
            if key == cur:
                row.add_css_class("tools-active")
            else:
                row.remove_css_class("tools-active")
        return self.get_visible()

    def pick(self, key):
        profile_set(key)
        self.refresh()
        GLib.timeout_add(250, self.close_now)

    def close_now(self):
        self.close()
        return False

    def on_key_pressed(self, _c, keyval, _code, _state):
        if keyval == Gdk.KEY_Escape:
            self.close()
            return True
        return False

    def on_active(self, *_a):
        if self.is_active():
            self.was_active = True
        elif self.was_active:
            GLib.timeout_add(150, self.close_if_inactive)

    def close_if_inactive(self):
        if not self.is_active():
            self.close()
        return False


# ---------------------------------------------------------------- Wi-Fi and Bluetooth menus
def cmd_out(cmd, timeout=8):
    """Run a command, never raise: (ok, stdout)."""
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return p.returncode == 0, p.stdout.strip()
    except Exception:
        return False, ""


def split_nmcli(line):
    """nmcli -t escapes a colon inside a value as \\: ; split on the other colons."""
    import re
    return [f.replace("\\:", ":").replace("\\\\", "\\") for f in re.split(r"(?<!\\):", line)]


def signal_bars(pct):
    return "▂▄▆█"[0 if pct < 25 else 1 if pct < 50 else 2 if pct < 75 else 3]


class Dropdown:
    """Closes like a dropdown: Esc, or a click anywhere else."""

    def setup_dropdown(self):
        self.was_active = False
        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", self.on_key_pressed)
        self.add_controller(keys)
        self.connect("notify::is-active", self.on_active)

    def on_key_pressed(self, _c, keyval, _code, _state):
        if keyval == Gdk.KEY_Escape:
            self.close()
            return True
        return False

    def on_active(self, *_a):
        if self.is_active():
            self.was_active = True
        elif self.was_active and not getattr(self, "keep_open", False):
            GLib.timeout_add(150, self.close_if_inactive)

    def close_if_inactive(self):
        if not self.is_active():
            self.close()
        return False

    def close_now(self):
        self.close()
        return False


def menu_row(title, sub="", mark=""):
    """One clickable line of a menu: title, small text under it, a mark on the right."""
    row = Gtk.Button()
    row.add_css_class("tools-item")
    box = Gtk.Box(spacing=10)
    text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1, hexpand=True)
    a = Gtk.Label(label=title, xalign=0)
    a.set_ellipsize(3)
    text.append(a)
    if sub:
        b = Gtk.Label(label=sub, xalign=0)
        b.add_css_class("tools-sub")
        b.set_ellipsize(3)
        text.append(b)
    box.append(text)
    tick = Gtk.Label(label=mark)
    box.append(tick)
    row.set_child(box)
    return row


class WifiWindow(ToolWindow, Dropdown):
    """Wi-Fi dropdown: switch Wi-Fi on or off, see nearby networks, connect or disconnect with one click."""

    def __init__(self, app):
        super().__init__(app, "Wi-Fi", WIFI_W, WIFI_H, with_close=False)
        self.busy = False          # a switch change made by the program itself must not run a command
        self.pending = None
        head = Gtk.Box(spacing=8)
        title = Gtk.Label(label="Wi-Fi", xalign=0, hexpand=True)
        title.add_css_class("power-big")
        head.append(title)
        self.switch = Gtk.Switch()
        self.switch.set_valign(Gtk.Align.CENTER)
        self.switch.connect("state-set", self.on_switch)
        head.append(self.switch)
        self.body.append(head)
        self.status = Gtk.Label(xalign=0, wrap=True)
        self.status.add_css_class("tools-sub")
        self.body.append(self.status)

        self.list = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        sc = Gtk.ScrolledWindow(vexpand=True)
        sc.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        sc.set_child(self.list)
        self.body.append(sc)

        # password for a new secured network (shown only when needed)
        self.pw_box = Gtk.Box(spacing=6)
        self.pw = Gtk.PasswordEntry(hexpand=True, show_peek_icon=True)
        self.pw.connect("activate", lambda _e: self.send_password())
        go = Gtk.Button(label="Connect")
        go.connect("clicked", lambda _b: self.send_password())
        self.pw_box.append(self.pw)
        self.pw_box.append(go)
        self.pw_box.set_visible(False)
        self.body.append(self.pw_box)

        more = Gtk.Button(label="Wi-Fi settings…")
        more.add_css_class("tools-item")
        more.connect("clicked", lambda _b: (xlin_ui.run(["xlin", "settings", "wifi"]), self.close()))
        self.body.append(more)

        self.setup_dropdown()
        self.refresh()
        GLib.timeout_add_seconds(6, self.refresh)
        # look for networks again right now (the list updates when the scan is done)
        threading.Thread(target=lambda: (cmd_out(["nmcli", "dev", "wifi", "rescan"], 10),
                                         GLib.idle_add(self.refresh)), daemon=True).start()

    # ---- reading the state (in a thread, so the menu never freezes)
    def refresh(self):
        if not self.get_visible():
            return False
        threading.Thread(target=self.read_state, daemon=True).start()
        return True

    def read_state(self):
        _ok, radio = cmd_out(["nmcli", "radio", "wifi"], 4)
        nets, known, dev = {}, set(), ""
        if radio == "enabled":
            ok, out = cmd_out(["nmcli", "-t", "-f", "IN-USE,SSID,SIGNAL,SECURITY", "dev", "wifi", "list",
                               "--rescan", "no"], 6)
            for line in out.splitlines() if ok else []:
                f = split_nmcli(line)
                if len(f) < 4 or not f[1]:
                    continue
                use, ssid, sig, sec = f[0] == "*", f[1], int(f[2] or 0), f[3]
                old = nets.get(ssid)
                if old is None or use or (not old["use"] and sig > old["sig"]):
                    nets[ssid] = {"ssid": ssid, "use": use, "sig": sig, "sec": bool(sec and sec != "--")}
            ok, out = cmd_out(["nmcli", "-t", "-f", "NAME,TYPE", "connection", "show"], 4)
            known = {split_nmcli(line)[0] for line in out.splitlines() if "wireless" in line}
            _ok, devs = cmd_out(["nmcli", "-t", "-f", "DEVICE,TYPE", "dev"], 4)
            dev = next((split_nmcli(line)[0] for line in devs.splitlines() if line.endswith(":wifi")), "")
        GLib.idle_add(self.show, radio, list(nets.values()), known, dev)

    def show(self, radio, nets, known, dev):
        self.dev = dev
        self.busy = True
        self.switch.set_active(radio == "enabled")
        self.busy = False
        while (c := self.list.get_first_child()) is not None:
            self.list.remove(c)
        if radio != "enabled":
            self.status.set_text("Wi-Fi is off")
            return False
        nets.sort(key=lambda n: (not n["use"], -n["sig"]))
        cur = next((n for n in nets if n["use"]), None)
        if self.pending:
            pass       # keep the "Connecting..." message until the command is done
        elif cur:
            self.status.set_text(f"Connected to {cur['ssid']}")
        else:
            self.status.set_text("Not connected" if nets else "No networks found")
        for n in nets[:10]:
            mark = "✓" if n["use"] else ("" if n["sec"] else "")
            sub = ("Connected · click to disconnect" if n["use"]
                   else "Saved network" if n["ssid"] in known else "Secured" if n["sec"] else "Open")
            row = menu_row(f"{signal_bars(n['sig'])}  {n['ssid']}", sub, mark)
            if n["use"]:
                row.add_css_class("tools-active")
            row.connect("clicked", lambda _b, net=n, k=known: self.pick(net, k))
            self.list.append(row)
        return False

    # ---- actions (all in threads)
    def on_switch(self, _s, state):
        if not self.busy:
            threading.Thread(target=lambda: (cmd_out(["nmcli", "radio", "wifi", "on" if state else "off"], 8),
                                             GLib.idle_add(self.refresh)), daemon=True).start()
            self.status.set_text("Turning Wi-Fi on…" if state else "Turning Wi-Fi off…")
        return False

    def run_and_refresh(self, cmd, doing, timeout=30):
        self.pending = doing
        self.status.set_text(doing)

        def work():
            ok, out = cmd_out(cmd, timeout)
            GLib.idle_add(self.done, ok, out)
        threading.Thread(target=work, daemon=True).start()

    def done(self, ok, out):
        self.pending = None
        if not ok:
            self.status.set_text((out.splitlines() or ["That did not work."])[-1][:80]
                                 if out else "Could not connect. Check the password and try again.")
        self.read_threaded()
        return False

    def read_threaded(self):
        threading.Thread(target=self.read_state, daemon=True).start()

    def pick(self, net, known):
        self.pw_box.set_visible(False)
        ssid = net["ssid"]
        if net["use"]:
            self.run_and_refresh(["nmcli", "dev", "disconnect", self.dev or "wlan0"], f"Disconnecting from {ssid}…", 10)
        elif ssid in known:
            self.run_and_refresh(["nmcli", "-w", "20", "connection", "up", "id", ssid], f"Connecting to {ssid}…")
        elif not net["sec"]:
            self.run_and_refresh(["nmcli", "-w", "20", "dev", "wifi", "connect", ssid], f"Connecting to {ssid}…")
        else:
            self.want = ssid
            self.keep_open = True       # typing a password: the menu must not close when focus moves
            self.pw.set_text("")
            self.pw_box.set_visible(True)
            self.pw.grab_focus()
            self.status.set_text(f"Password for {ssid}")

    def send_password(self):
        pw = self.pw.get_text()
        ssid = getattr(self, "want", "")
        if not ssid or not pw:
            return
        self.pw_box.set_visible(False)
        self.keep_open = False
        self.run_and_refresh(["nmcli", "-w", "25", "dev", "wifi", "connect", ssid, "password", pw], f"Connecting to {ssid}…", 35)


class BluetoothWindow(ToolWindow, Dropdown):
    """Bluetooth dropdown: switch Bluetooth on or off, connect or disconnect your paired devices."""

    def __init__(self, app):
        super().__init__(app, "Bluetooth", BT_W, BT_H, with_close=False)
        self.busy = False
        self.pending = None
        head = Gtk.Box(spacing=8)
        title = Gtk.Label(label="Bluetooth", xalign=0, hexpand=True)
        title.add_css_class("power-big")
        head.append(title)
        self.switch = Gtk.Switch()
        self.switch.set_valign(Gtk.Align.CENTER)
        self.switch.connect("state-set", self.on_switch)
        head.append(self.switch)
        self.body.append(head)
        self.status = Gtk.Label(xalign=0, wrap=True)
        self.status.add_css_class("tools-sub")
        self.body.append(self.status)

        self.list = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        sc = Gtk.ScrolledWindow(vexpand=True)
        sc.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        sc.set_child(self.list)
        self.body.append(sc)

        more = Gtk.Button(label="Pair a new device…")
        more.add_css_class("tools-item")
        more.connect("clicked", lambda _b: (xlin_ui.run(["xlin", "settings", "bluetooth"]), self.close()))
        self.body.append(more)

        self.setup_dropdown()
        self.refresh()
        GLib.timeout_add_seconds(5, self.refresh)

    def refresh(self):
        if not self.get_visible():
            return False
        threading.Thread(target=self.read_state, daemon=True).start()
        return True

    def read_state(self):
        _ok, show = cmd_out(["bluetoothctl", "show"], 4)
        _ok, rf = cmd_out(["rfkill", "list", "bluetooth"], 3)
        powered = "Powered: yes" in show and "Soft blocked: yes" not in rf
        devices = []
        if powered:
            ok, out = cmd_out(["bluetoothctl", "devices", "Paired"], 4)
            if not ok or not out:
                ok, out = cmd_out(["bluetoothctl", "paired-devices"], 4)
            for line in out.splitlines():
                parts = line.split(" ", 2)
                if len(parts) == 3 and parts[0] == "Device":
                    _ok, info = cmd_out(["bluetoothctl", "info", parts[1]], 4)
                    devices.append({"mac": parts[1], "name": parts[2], "on": "Connected: yes" in info})
        GLib.idle_add(self.show, powered, devices, bool(show))

    def show(self, powered, devices, have_adapter):
        self.busy = True
        self.switch.set_active(powered)
        self.busy = False
        while (c := self.list.get_first_child()) is not None:
            self.list.remove(c)
        if not have_adapter:
            self.status.set_text("No Bluetooth adapter found")
            return False
        if not powered:
            self.status.set_text("Bluetooth is off")
            return False
        devices.sort(key=lambda d: (not d["on"], d["name"].lower()))
        if not self.pending:
            on = [d["name"] for d in devices if d["on"]]
            self.status.set_text(("Connected: " + ", ".join(on)) if on else
                                 ("Not connected" if devices else "No paired devices yet"))
        for d in devices:
            row = menu_row(d["name"], "Connected · click to disconnect" if d["on"] else "Click to connect",
                           "✓" if d["on"] else "")
            if d["on"]:
                row.add_css_class("tools-active")
            row.connect("clicked", lambda _b, dev=d: self.pick(dev))
            self.list.append(row)
        return False

    def on_switch(self, _s, state):
        if self.busy:
            return False

        def work():
            if state:
                cmd_out(["rfkill", "unblock", "bluetooth"], 4)
            cmd_out(["bluetoothctl", "power", "on" if state else "off"], 8)
            GLib.idle_add(self.refresh)
        threading.Thread(target=work, daemon=True).start()
        self.status.set_text("Turning Bluetooth on…" if state else "Turning Bluetooth off…")
        return False

    def pick(self, dev):
        self.pending = True
        self.status.set_text(("Disconnecting from " if dev["on"] else "Connecting to ") + dev["name"] + "…")

        def work():
            ok, out = cmd_out(["bluetoothctl", "disconnect" if dev["on"] else "connect", dev["mac"]], 20)
            GLib.idle_add(self.done, ok, dev)
        threading.Thread(target=work, daemon=True).start()

    def done(self, ok, dev):
        self.pending = None
        if not ok:
            self.status.set_text(f"Could not reach {dev['name']}. Is it switched on and close by?")
        threading.Thread(target=self.read_state, daemon=True).start()
        return False


# ---------------------------------------------------------------- volume menu
SINK = "@DEFAULT_AUDIO_SINK@"


def read_volume():
    """(percent, muted) of the default speakers, or None when there is no sound server."""
    import re
    ok, out = cmd_out(["wpctl", "get-volume", SINK], 3)
    m = re.search(r"([\d.]+)", out) if ok else None
    if not m:
        return None
    return int(float(m.group(1)) * 100 + 0.5), "MUTED" in out


def read_sinks():
    """[(id, name, is_default)] of the sound outputs, from `wpctl status`."""
    import re
    ok, out = cmd_out(["wpctl", "status"], 4)
    sinks, inside = [], False
    for line in out.splitlines() if ok else []:
        bare = line.replace("│", " ").replace("├", " ").replace("└", " ").replace("─", " ").strip()
        if bare.startswith("Sinks:"):
            inside = True
            continue
        if inside:
            if re.match(r"^[│\s]*[├└]", line) or not bare:
                break
            m = re.match(r"^(\*)?\s*(\d+)\.\s+(.*?)(\s+\[vol:.*)?$", bare)
            if m:
                sinks.append((m.group(2), m.group(3), bool(m.group(1))))
    return sinks


class VolumeWindow(ToolWindow, Dropdown):
    """Volume dropdown: a slider, a mute switch and the sound outputs. Opens from the speaker icon on the top bar."""

    def __init__(self, app):
        super().__init__(app, "Volume", VOL_W, VOL_H, with_close=False)
        self.busy = False
        self.last_touch = 0.0
        self.timer = 0
        head = Gtk.Box(spacing=8)
        title = Gtk.Label(label="Sound", xalign=0, hexpand=True)
        title.add_css_class("power-big")
        head.append(title)
        mute_label = Gtk.Label(label="Mute")
        mute_label.add_css_class("tools-sub")
        head.append(mute_label)
        self.mute = Gtk.Switch()
        self.mute.set_valign(Gtk.Align.CENTER)
        self.mute.connect("state-set", self.on_mute)
        head.append(self.mute)
        self.body.append(head)

        line = Gtk.Box(spacing=10, margin_top=6)
        self.icon = Gtk.Label(label="\uf028")
        line.append(self.icon)
        self.scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        self.scale.set_hexpand(True)
        self.scale.set_draw_value(False)
        self.scale.connect("value-changed", self.on_volume)
        line.append(self.scale)
        self.pct = Gtk.Label(label="--%", xalign=1)
        self.pct.set_width_chars(4)
        line.append(self.pct)
        self.body.append(line)

        self.status = Gtk.Label(xalign=0, wrap=True)
        self.status.add_css_class("tools-sub")
        self.body.append(self.status)
        out = Gtk.Label(label="Output", xalign=0, margin_top=8)
        out.add_css_class("tools-sub")
        self.body.append(out)
        self.list = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        sc = Gtk.ScrolledWindow(vexpand=True)
        sc.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        sc.set_child(self.list)
        self.body.append(sc)
        if shutil.which("pavucontrol"):
            more = Gtk.Button(label="Sound mixer…")
            more.add_css_class("tools-item")
            more.connect("clicked", lambda _b: (xlin_ui.run(["pavucontrol"]), self.close()))
            self.body.append(more)

        self.setup_dropdown()
        self.refresh()
        GLib.timeout_add_seconds(2, self.refresh)

    def refresh(self):
        if not self.get_visible():
            return False
        threading.Thread(target=lambda: GLib.idle_add(self.show, read_volume(), read_sinks()), daemon=True).start()
        return True

    def show(self, vol, sinks):
        if vol is None:
            self.status.set_text("No sound output found")
            return False
        if time.monotonic() - self.last_touch > 1.5:          # never fight the handle while it is being dragged
            self.busy = True
            self.scale.set_value(min(100, vol[0]))
            self.mute.set_active(vol[1])
            self.busy = False
            self.pct.set_text(f"{vol[0]}%")
        self.icon.set_text("\uf026" if vol[1] else "\uf028")
        self.status.set_text("Muted" if vol[1] else "")
        while (c := self.list.get_first_child()) is not None:
            self.list.remove(c)
        for sid, name, current in sinks:
            row = menu_row(name, "", "✓" if current else "")
            if current:
                row.add_css_class("tools-active")
            row.connect("clicked", lambda _b, i=sid: self.use_sink(i))
            self.list.append(row)
        return False

    def on_volume(self, scale):
        if self.busy:
            return
        v = int(scale.get_value())
        self.last_touch = time.monotonic()
        self.pct.set_text(f"{v}%")
        if self.timer:
            GLib.source_remove(self.timer)
        self.timer = GLib.timeout_add(40, self.apply_volume, v)

    def apply_volume(self, v):
        self.timer = 0
        threading.Thread(target=lambda: cmd_out(["wpctl", "set-volume", SINK, f"{v / 100:.2f}"], 3), daemon=True).start()
        if v > 0:      # dragging the handle up from silence also unmutes, like on a phone
            threading.Thread(target=lambda: cmd_out(["wpctl", "set-mute", SINK, "0"], 3), daemon=True).start()
            self.busy = True
            self.mute.set_active(False)
            self.busy = False
            self.status.set_text("")
        return False

    def on_mute(self, _s, state):
        if not self.busy:
            self.last_touch = 0.0
            threading.Thread(target=lambda: (cmd_out(["wpctl", "set-mute", SINK, "1" if state else "0"], 3),
                                             GLib.idle_add(self.refresh)), daemon=True).start()
        return False

    def use_sink(self, sid):
        threading.Thread(target=lambda: (cmd_out(["wpctl", "set-default", sid], 4),
                                         GLib.idle_add(self.refresh)), daemon=True).start()


