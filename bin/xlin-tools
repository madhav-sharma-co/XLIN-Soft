class ManualWindow(ToolWindow):
    """The manual: tabs for Start, Desktop, Apps, Shortcuts, Help and About."""

    def __init__(self, app):
        super().__init__(app, "Xman", MANUAL_W, MANUAL_H, with_close=True, resizable=True)
        head = Gtk.Box(spacing=12)
        icon = Gtk.Image.new_from_icon_name("xlin-manual")
        icon.set_pixel_size(44)
        head.append(icon)
        titles = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1, valign=Gtk.Align.CENTER)
        t = Gtk.Label(label="Xman", xalign=0)
        t.add_css_class("power-big")
        titles.append(t)
        ok, ver = cmd_out(["xlin", "version"], 3)
        v = Gtk.Label(label="Xlin-soft Manual" + ((" · " + ver) if ok else ""), xalign=0)
        v.add_css_class("tools-sub")
        titles.append(v)
        head.append(titles)
        self.body.append(head)

        self.stack = Gtk.Stack(vexpand=True)
        self.stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        tabs = Gtk.Box(spacing=0, margin_top=8, margin_bottom=6)
        tabs.add_css_class("linked")
        first = None
        for name, content in MANUAL_TABS:
            b = Gtk.ToggleButton(label=name)
            if first is None:
                first = b
            else:
                b.set_group(first)
            b.connect("toggled", lambda btn, n=name: btn.get_active() and self.stack.set_visible_child_name(n))
            tabs.append(b)
            self.stack.add_named(self.page(content), name)
        first.set_active(True)
        self.body.append(tabs)
        self.body.append(self.stack)

        row = Gtk.Box(spacing=8, margin_top=6)
        for label, cmd in (("Open Settings", ["xlin", "settings"]), ("SysDeb", ["xlin", "debug"]),
                           ("Welcome tour", ["xlin", "welcome"])):
            b = Gtk.Button(label=label)
            b.connect("clicked", lambda _b, c=cmd: xlin_ui.run(c))
            row.append(b)
        self.body.append(row)
        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", lambda _c, k, _cd, _st: (self.close(), True)[1] if k == Gdk.KEY_Escape else False)
        self.add_controller(keys)

    def page(self, content):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        box.set_margin_end(10)
        if content is None:                      # the live shortcut list
            ok, out = cmd_out(["xlin", "keys"], 5)
            text = re.sub(r"\x1b\[[0-9;]*m", "", out) if ok and out else "Run xlin keys in a terminal."
            lab = Gtk.Label(label=text.strip(), xalign=0, yalign=0)
            lab.add_css_class("tools-sub")
            lab.set_selectable(True)
            lab.set_attributes(Pango.AttrList.from_string("0 -1 family monospace"))
            box.append(lab)
        else:
            for kind, text in content:
                lab = Gtk.Label(label=text, xalign=0, wrap=True)
                lab.set_selectable(kind == "p")
                if kind == "h":
                    lab.add_css_class("power-big" if text.startswith("Welcome") else "tool-title")
                    lab.set_margin_top(10)
                else:
                    lab.add_css_class("tools-sub")
                box.append(lab)
        sc = Gtk.ScrolledWindow(vexpand=True)
        sc.set_child(box)
        return sc


class SessionWindow(ToolWindow):
    """Narrow vertical dropdown: Lock Screen, Sleep, Log Out, Restart, Power Off.
    Log Out, Restart and Power Off ask for a second click so they cannot happen by accident."""

    def __init__(self, app):
        super().__init__(app, "Power", SESSION_W, SESSION_H, with_close=False)
        self.was_active = False
        self.armed = None
        self.rows = {}
        for key, glyph, label, cmd, confirm in SESSION_ITEMS:
            row = Gtk.Button()
            row.add_css_class("tools-item")
            box = Gtk.Box(spacing=12)
            g = Gtk.Label(label=glyph, width_chars=2)
            t = Gtk.Label(label=label, xalign=0, hexpand=True)
            box.append(g)
            box.append(t)
            row.set_child(box)
            row.connect("clicked", lambda _b, k=key: self.on_pick(k))
            self.rows[key] = (row, t, label)
            self.body.append(row)
        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", self.on_key_pressed)
        self.add_controller(keys)
        self.connect("notify::is-active", self.on_active)

    def item(self, key):
        return next(i for i in SESSION_ITEMS if i[0] == key)

    def on_pick(self, key):
        _k, _g, _label, cmd, confirm = self.item(key)
        if confirm and self.armed != key:
            self.disarm()
            self.armed = key
            row, t, _l = self.rows[key]
            t.set_text("Click to confirm")
            row.add_css_class("tools-danger")
            GLib.timeout_add(3000, self.disarm)
            return
        exe = shutil.which("xlin") or "xlin"
        self.close()
        subprocess.Popen([exe, cmd], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def disarm(self):
        if self.armed:
            row, t, label = self.rows[self.armed]
            t.set_text(label)
            row.remove_css_class("tools-danger")
            self.armed = None
        return False

    def on_key_pressed(self, _c, keyval, _code, _state):
        if keyval == Gdk.KEY_Escape:
            self.close()
            return True
        return False

    def on_active(self, *_a):
        if self.is_active():
            self.was_active = True
        elif self.was_active:
            GLib.timeout_add(150, self.close_if_inactive)

    def close_if_inactive(self):
        if not self.is_active():
            self.close()
        return False


class FloatingTool(ToolWindow):
    """A tool in its own window: stays open until you press x (or Esc)."""

    def __init__(self, app, key):
        label, _id, w, h, _sub, _icon = TOOLS[key]
        super().__init__(app, label, w, h, with_close=True, resizable=True)
        self.tool = {"calculator": Calculator, "calendar": CalendarView, "notes": NotesView,
                     "screenshot": ScreenshotView, "clock": ClockView}[key]()
        self.tool.window = self
        self.connect("close-request", lambda *_: (getattr(self.tool, "flush", lambda: None)(), False)[1])
        self.body.append(self.tool)
        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", self.on_key_pressed)
        self.add_controller(keys)

    def on_key_pressed(self, _c, keyval, _code, _state):
        if keyval == Gdk.KEY_Escape:
            self.close()
            return True
        return bool(self.tool.on_key(keyval))


class ToolsApp(Gtk.Application):
    def __init__(self, mode):
        mode = mode if (mode in TOOLS or mode in EXTRA_IDS) else None
        app_id = EXTRA_IDS.get(mode) or (TOOLS[mode][1] if mode else MENU_ID)
        super().__init__(application_id=app_id, flags=Gio.ApplicationFlags.FLAGS_NONE)
        self.mode = mode
        self.win = None

    def do_startup(self):
        Gtk.Application.do_startup(self)
        xlin_ui.live_css()      # restyle at once when the theme or font changes (warm apps too)
        display = Gdk.Display.get_default()
        for data in (FALLBACK_CSS, self.read_theme_css()):
            if not data:
                continue
            prov = Gtk.CssProvider()
            try:
                prov.load_from_data(data)
            except Exception:
                continue
            Gtk.StyleContext.add_provider_for_display(
                display, prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    @staticmethod
    def read_theme_css():
        try:
            with open(CSS_FILE, "rb") as f:
                return f.read()
        except OSError:
            return None

    def do_activate(self):
        if self.win is not None:      # already open: just bring it forward
            self.win.present()
            return
        if self.mode is None:
            self.win = MenuWindow(self)
        elif self.mode == "power":
            self.win = PowerWindow(self)
        elif self.mode == "session":
            self.win = SessionWindow(self)
        elif self.mode == "wifi":
            self.win = WifiWindow(self)
        elif self.mode == "bluetooth":
            self.win = BluetoothWindow(self)
        elif self.mode == "manual":
            self.win = ManualWindow(self)
        elif self.mode == "volume":
            self.win = VolumeWindow(self)
        else:
            self.win = FloatingTool(self, self.mode)
        self.win.present()
        app_id = self.get_application_id()
        stagger = self.mode in TOOLS
        GLib.timeout_add(120, place_window, app_id, stagger, stagger)
        GLib.timeout_add(400, place_window, app_id, stagger, stagger)  # again once Hyprland settled the size


if __name__ == "__main__":
    mode = sys.argv[1].lower() if len(sys.argv) > 1 else None
    if mode and mode not in TOOLS and mode not in EXTRA_IDS:
        print("usage: xlin-tools [calculator|calendar|power|session|wifi|bluetooth|volume|manual]")
        sys.exit(2)
    sys.exit(ToolsApp(mode).run([sys.argv[0]]))
