{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "overlay",
  "control-center-width": 330,
  "control-center-margin-top": 46,
  "control-center-margin-right": 12,
  "control-center-margin-bottom": 12,
  "control-center-height": 560,
  "notification-window-width": 340,
  "notification-icon-size": 40,
  "timeout": 6,
  "timeout-low": 4,
  "timeout-critical": 0,
  "fit-to-screen": false,
  "hide-on-clear": false,
  "widgets": [
    "menubar#top",
    "title",
    "buttons-grid",
    "volume",
    "backlight",
    "buttons-grid#power",
    "notifications"
  ],
  "widget-config": {
    "menubar#top": {
      "buttons#close": {
        "position": "right",
        "actions": [
          {
            "label": "✕",
            "command": "swaync-client -cp"
          }
        ]
      }
    },
    "title": {
      "text": "Control Panel",
      "clear-all-button": true,
      "button-text": "Clear"
    },
    "buttons-grid": {
      "buttons-per-row": 2,
      "actions": [
        {
          "label": "  Wi-Fi",
          "command": "xlin toggle wifi",
          "type": "toggle",
          "active": false,
          "update-command": "xlin state wifi"
        },
        {
          "label": "  Bluetooth",
          "command": "xlin toggle bluetooth",
          "type": "toggle",
          "active": false,
          "update-command": "xlin state bluetooth"
        },
        {
          "label": "  Airplane",
          "command": "xlin toggle airplane",
          "type": "toggle",
          "active": false,
          "update-command": "xlin state airplane"
        },
        {
          "label": "  Do not disturb",
          "type": "toggle",
          "active": false,
          "command": "swaync-client -d",
          "update-command": "swaync-client -D"
        },
        {
          "label": "  Dark mode",
          "command": "xlin theme toggle",
          "type": "toggle",
          "active": false,
          "update-command": "xlin state dark"
        },
        {
          "label": "  Night light",
          "command": "xlin nightlight toggle",
          "type": "toggle",
          "active": false,
          "update-command": "xlin state nightlight"
        },
        {
          "label": "  Settings",
          "command": "xlin settings"
        },
        {
          "label": "  Reload",
          "command": "sh -c 'swaync-client -cp; setsid -f xlin restart >/dev/null 2>&1'"
        }
      ]
    },
    "volume": {
      "label": ""
    },
    "backlight": {
      "label": ""
    }
  }
}
